<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/month_cell_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="1dp"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_day_cell">

    <TextView
        android:id="@+id/month_cell_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="@color/widget_weekday_text" />

    <TextView android:id="@+id/month_cell_line1" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />
    <TextView android:id="@+id/month_cell_line2" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />
    <TextView android:id="@+id/month_cell_line3" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />
    <TextView android:id="@+id/month_cell_line4" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />
    <TextView android:id="@+id/month_cell_line5" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />
    <TextView android:id="@+id/month_cell_line6" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />
    <TextView android:id="@+id/month_cell_line7" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />
    <TextView android:id="@+id/month_cell_line8" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="9sp" android:visibility="gone" />

    <TextView
        android:id="@+id/month_cell_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="8sp"
        android:textColor="#FF6B7280"
        android:visibility="gone" />
</LinearLayout>
