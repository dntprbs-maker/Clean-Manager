<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_card"
    android:padding="8dp">

    <!-- 1행: 브랜드 / 연월 / 오늘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/twoweek_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="클린매니저"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/widget_brand_green" />

        <TextView
            android:id="@+id/twoweek_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/widget_brand_green" />

        <TextView
            android:id="@+id/twoweek_today_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_bg_pill_button"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="오늘"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/widget_button_text_green" />
    </LinearLayout>

    <!-- 2행: 지난주 / 날짜범위 / 다음주 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/twoweek_prev_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg_pill_button"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="‹ 지난주"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/widget_button_text_green" />

        <TextView
            android:id="@+id/twoweek_date_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:gravity="center"
            android:singleLine="true"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/widget_date_range_text" />

        <TextView
            android:id="@+id/twoweek_next_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg_pill_button"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="다음주 ›"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/widget_button_text_green" />
    </LinearLayout>

    <!-- 위 주 1줄: 일 / 월 / 화 / 수 -->
    <LinearLayout
        android:id="@+id/twoweek_row_top_a"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal" />

    <!-- 위 주 2줄: 보조칸 / 목 / 금 / 토 -->
    <LinearLayout
        android:id="@+id/twoweek_row_top_b"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

    <!-- 구분선 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider" />

    <!-- 아래 주 1줄: 일 / 월 / 화 / 수 -->
    <LinearLayout
        android:id="@+id/twoweek_row_bottom_a"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal" />

    <!-- 아래 주 2줄: 보조칸 / 목 / 금 / 토 -->
    <LinearLayout
        android:id="@+id/twoweek_row_bottom_b"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal" />

</LinearLayout>
