<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="34dp">
        <TextView android:id="@+id/brand" android:text="▣  클린메니저" android:textStyle="bold" android:textSize="13sp" android:textColor="#166534" android:gravity="center_vertical" android:singleLine="true" android:layout_width="110dp" android:layout_height="match_parent" />
        <TextView android:id="@+id/year_title" android:text="2026년" android:textStyle="bold" android:textSize="21sp" android:textColor="#166534" android:gravity="center" android:singleLine="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" />
        <TextView android:id="@+id/today" android:text="오늘" android:textStyle="bold" android:textSize="12sp" android:textColor="#166534" android:gravity="center" android:background="@drawable/nav_button" android:layout_width="70dp" android:layout_height="30dp" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="38dp">
        <TextView android:id="@+id/prev" android:text="‹ 지난주" android:textStyle="bold" android:textSize="12sp" android:textColor="#166534" android:gravity="center" android:background="@drawable/nav_button" android:layout_width="84dp" android:layout_height="32dp" />
        <TextView android:id="@+id/week_title" android:text="8월 23일 (일) ~ 8월 29일 (토)" android:textStyle="bold" android:textSize="12sp" android:textColor="#1F2937" android:gravity="center" android:singleLine="true" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" />
        <TextView android:id="@+id/next" android:text="다음주 ›" android:textStyle="bold" android:textSize="12sp" android:textColor="#166534" android:gravity="center" android:background="@drawable/nav_button" android:layout_width="84dp" android:layout_height="32dp" />
    </LinearLayout>

    <TextView android:id="@+id/loading" android:text="일정 불러오는 중…" android:textSize="10sp" android:textColor="#9CA3AF" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/week_row1" android:orientation="horizontal" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/week_row2" android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
