<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/cell_border"
    android:layout_margin="2dp"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/mini_month"
        android:text="8월"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="#16784B"
        android:gravity="center"
        android:paddingBottom="3dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="일   월   화   수   목   금   토"
        android:textSize="8sp"
        android:textColor="#6B7280"
        android:gravity="center"
        android:singleLine="true"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/mini_row1" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/mini_row2" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/mini_row3" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/mini_row4" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/mini_row5" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/mini_row6" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
